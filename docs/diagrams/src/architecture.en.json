  "cards": [
    {
      "dot": "cyan",
      "title": "Distribution",
      "items": [
        "package.json#oscaner is the only hand-written source — emit derives source.json and every harness manifest",
        "emit:check fails CI on any drift; generated products are never hand-edited",
        "kairos ships the skills; cdd-engine ships the CLI and templates to npm"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution",
      "items": [
        "The engine runs eight commands: implement · review · fix · base · schema · issue · board · init",
        "Each work command runs tree-clean → graph → wave → doc-contract before any child dispatch",
        "The child receives a static shell + frozen return + one dynamic round-context zone, so prompt-cache prefixes stay byte-stable"
      ]
    },
    {
      "dot": "amber",
      "title": "Convergence",
      "items": [
        "Review findings carry blocker / warn / nit; any finding routes to fix, a one-way hop",
        "A fix with blockers left is re-reviewed; warn/nit-only closes as REVIEW_FIX without re-review",
        "The next: line is the only continuation — BLOCKED and TIMEOUT rounds carry no next line"
      ]
    },
    {
      "dot": "violet",
      "title": "Run state",
      "items": [
        "All round handoffs, ledgers and briefs live under .kairos/cdd in the consumer repo",
        "The workspace publishes .kairos/.gitignore with '*' at first dispatch, so run state never dirties commits",
        "CDD docs live under docs/kairos/{overalls,specs,plans}; the engine reads the declared slug identity"
      ]
    }
  ]
