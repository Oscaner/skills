  "cards": [
    {
      "dot": "cyan",
      "title": "分发",
      "items": [
        "package.json#oscaner 是唯一手写来源——emit 派生 source.json 与全部 harness 清单",
        "emit:check 在 CI 中拦截任何漂移；生成产物永不手改",
        "kairos 发布技能；cdd-engine 将 CLI 与模板发布到 npm"
      ]
    },
    {
      "dot": "emerald",
      "title": "执行",
      "items": [
        "引擎提供七条命令：implement · review · fix · base · schema · issue · board",
        "每条工作命令先过 干净树 → 图 → 波次 → 文档契约，再派发子代理",
        "子代理收到静态外壳 + 冻结返回 + 单一动态上下文区，提示词缓存前缀保持字节稳定"
      ]
    },
    {
      "dot": "amber",
      "title": "收敛",
      "items": [
        "评审发现分为 blocker / warn / nit；任何发现都单向进入 fix",
        "仍有 blocker 的 fix 会重新评审；仅 warn/nit 时以 REVIEW_FIX 收敛，不再评审",
        "next: 行是唯一续行动作——BLOCKED 与 TIMEOUT 轮不产生 next 行"
      ]
    },
    {
      "dot": "violet",
      "title": "运行态",
      "items": [
        "所有轮次 handoff、账本与简报位于消费方仓库的 .kairos/cdd 下",
        "工作区在首次派发时自发布 .kairos/.gitignore（内容 *），运行态永不弄脏提交",
        "CDD 文档位于 docs/kairos/{overalls,specs,plans}；引擎读取声明的 slug 身份"
      ]
    }
  ]
