  "cards": [
    {
      "dot": "cyan",
      "title": "一条链，一个收口",
      "items": [
        "每个阶段都以评审收尾；spec、plan、波次与分支评审共享 Review Convergence 规则",
        "blocker 发现进入 fix 并重新评审；仅 warn/nit 时以 REVIEW_FIX 收敛；零发现直接关闭",
        "cdd-close 先落地收尾回填，再询问开发者如何完成分支"
      ]
    },
    {
      "dot": "rose",
      "title": "三种 spec 目标",
      "items": [
        "single-spec —— 整个程序恰好装进一份 spec；docs/kairos/specs",
        "phase-spec —— 一个已登记阶段；docs/kairos/specs，携带 program:（父 overall 的 slug）",
        "overall —— 多阶段项目章程；docs/kairos/overalls，随后交给下一阶段设计",
        "设计流程按规模分流：single-spec / fit → cdd-spec-writer；multi / oversized → overall 章程"
      ]
    },
    {
      "dot": "orange",
      "title": "Backfill 与 annotate —— 两条回流",
      "items": [
        "回填把持久事实落到其归属文档（overall · spec · plan），绝不留在聊天里",
        "中途回填：立即落地 → 独立提交 → 暂停循环直至干净 → 下一次评审在带内审计",
        "cdd-plan 在规划暴露漂移时回填 spec；cdd-close 在完成菜单前回填收尾",
        "annotate：需要裁定的发现把裁定写入发现载体；fix 消费已批注的载体"
      ]
    },
    {
      "dot": "emerald",
      "title": "next: 契约",
      "items": [
        "引擎的 next: 行是唯一续行动作——编排器跟随它，而不是重新决策",
        "implement → review → fix → next-wave | done；分支评审是最终门禁",
        "BLOCKED 或 TIMEOUT 轮输出 CDD_BLOCKED，且不携带 next: 行"
      ]
    },
    {
      "dot": "amber",
      "title": "派发前的门禁",
      "items": [
        "预检顺序：干净树 → plan 图 → 波次门 → 文档契约",
        "脏工作树在任何子代理启动前 BLOCK；未提交的回填同样触发该门",
        "所有提示词、发现与账本都是 .kairos/cdd 下的文件，而非聊天状态"
      ]
    },
    {
      "dot": "violet",
      "title": "最终交付",
      "items": [
        "任务提交累积在特性分支；分支评审审阅整段 diff",
        "cdd-close 提供 merge / PR / 保留 / 丢弃；每次变更都带 changeset",
        "develop 是集成分支；生产发布经 develop → main → npm"
      ]
    }
  ]
}