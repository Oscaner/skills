  "cards": [
    {
      "dot": "rose",
      "title": "findings 如何判定",
      "items": [
        "每条 finding 携带严重度（blocker · warn · nit）、lens 与摘要；section、line、fix 可选",
        "findings 只由评审轮产出——fix 轮只消费它们，自身从不产出裁定",
        "评审从不自行声明状态——由引擎汇总：blocker → CHANGES_REQUESTED · warn/nit → REVIEW_FIX · 无 → APPROVED",
        "按真实严重度校准——并非一切都是 blocker；被审对象是愿景而非穷举，沉默不等于许可",
        "逐条列出被判定为范围外的行为并写明理由；在列出 findings 前先肯定做得好的部分"
      ]
    },
    {
      "dot": "amber",
      "title": "各评审类型的 lens",
      "items": [
        "wave / 分支 —— standards · spec · buildability；buildability 发现须自报 typecheck 与测试双重证据",
        "spec —— completeness · consistency · clarity；程序一致性 + 每条主张都有同址 pin",
        "plan —— completeness · decomposition · buildability；spec 一致性 + 每条主张都有同址 pin",
        "分支评审在同一组轴上追加设计、测试充分性与迁移路径"
      ]
    },
    {
      "dot": "cyan",
      "title": "单向 fix，统一收口",
      "items": [
        "评审轮的 findings 决定路线：有发现（任意严重度）→ fix；零发现 → 直接收口",
        "fix 只消费评审给出的 findings，自身从不产出裁定",
        "fix 完成后：来源评审有 blocker → 重新评审；来源评审仅 warn/nit → 以 REVIEW_FIX 收口",
        "重新评审按同一规则继续 loop，直到收口；连续 20 个 blocker 周期 → 软上限，由用户裁定"
      ]
    },
    {
      "dot": "emerald",
      "title": "next: 契约",
      "items": [
        "引擎的 next: 行是唯一续行动作；BLOCKED 或 TIMEOUT 轮不携带该行",
        "只要批次还有就绪任务，收口就是 next-wave；运行耗尽则是 done",
        "流水线交接：phase-spec → cdd-plan · plan → cdd-dev · wave → review --type branch · branch → cdd-close · overall → done"
      ]
    }
  ]
