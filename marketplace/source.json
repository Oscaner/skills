{
  "$schema": "./source.schema.json",
  "name": "oscaner",
  "owner": {
    "name": "Oscaner Miao"
  },
  "metadata": {
    "description": "Personal skill collection: superpowers/mattpocock-skills overrides and standalone skills."
  },
  "plugins": [
    {
      "name": "mattpocock-skills",
      "description": "Matt Pocock's agent skills for real engineering",
      "author": {
        "name": "Matt Pocock",
        "url": "https://github.com/mattpocock"
      },
      "homepage": "https://github.com/mattpocock/skills",
      "repository": "https://github.com/mattpocock/skills",
      "license": "MIT",
      "contentRoot": "plugins/mattpocock-skills",
      "claude": {
        "category": "engineering",
        "keywords": [
          "engineering",
          "skills",
          "tdd",
          "code-review",
          "grilling"
        ]
      },
      "cursor": {
        "displayName": "Matt Pocock Skills",
        "skills": "../../plugins/mattpocock-skills/skills"
      }
    },
    {
      "name": "impeccable",
      "version": "4.0.4",
      "description": "Design fluency for frontend development. 1 skill with 23 commands (/impeccable polish, /impeccable audit, /impeccable critique, etc.) and curated anti-pattern detection.",
      "author": {
        "name": "Paul Bakaus",
        "email": "paul@paulbakaus.com"
      },
      "homepage": "https://impeccable.style",
      "contentRoot": "plugins/impeccable/plugin",
      "claude": {
        "category": "design",
        "tags": [
          "design",
          "frontend",
          "ui",
          "ux",
          "skills",
          "commands"
        ]
      },
      "cursor": {
        "displayName": "Impeccable",
        "skills": "../../plugins/impeccable/plugin/skills"
      }
    },
    {
      "name": "superpowers",
      "version": "6.2.0",
      "description": "Core skills library for Claude Code: TDD, debugging, collaboration patterns, and proven techniques",
      "author": {
        "name": "Jesse Vincent",
        "email": "jesse@fsck.com"
      },
      "contentRoot": "plugins/superpowers",
      "cursor": {
        "emitMode": "plugin-root"
      }
    },
    {
      "name": "superpowers-overrides",
      "version": "6.2.0-overrides.0.15.3",
      "description": "Personal overrides for the superpowers plugin that force delegation to other skills.",
      "author": {
        "name": "Oscaner Miao",
        "email": "oscaner1997@gmail.com"
      },
      "license": "MIT",
      "contentRoot": "plugins/superpowers-overrides",
      "claude": {
        "category": "workflow",
        "tags": [
          "superpowers",
          "mattpocock",
          "overrides",
          "subagents"
        ]
      },
      "cursor": {
        "emitMode": "plugin-root"
      }
    },
    {
      "name": "os-engineering",
      "version": "0.1.0",
      "description": "Standalone engineering skills: cli-* orchestration family (select/task/driven-development/code-review) on the cdd engine.",
      "author": {
        "name": "Oscaner Miao",
        "email": "oscaner1997@gmail.com"
      },
      "license": "MIT",
      "contentRoot": "plugins/os-engineering",
      "claude": {
        "category": "engineering",
        "keywords": [
          "engineering",
          "cli",
          "cdd",
          "harness",
          "droid",
          "pi"
        ]
      },
      "cursor": {
        "emitMode": "plugin-root"
      }
    }
  ]
}
