{
  "$schema": "./source.schema.json",
  "name": "oscaner",
  "owner": {
    "name": "Oscaner Miao"
  },
  "metadata": {
    "description": "Personal skill collection: superpowers/mattpocock-skills overrides and standalone skills."
  },
  "plugins": [
    {
      "name": "mattpocock-skills",
      "contentRoot": "vendors/mattpocock-skills",
      "cursor": {
        "displayName": "Matt Pocock Skills",
        "skills": "../../vendors/mattpocock-skills/skills"
      },
      "version": "1.1.0",
      "description": "Matt Pocock's agent skills for real engineering",
      "author": {
        "name": "Matt Pocock",
        "url": "https://github.com/mattpocock"
      },
      "homepage": "https://github.com/mattpocock/skills",
      "repository": "https://github.com/mattpocock/skills",
      "license": "MIT",
      "claude": {
        "category": "engineering",
        "keywords": [
          "engineering",
          "skills",
          "tdd",
          "code-review",
          "grilling"
        ]
      }
    },
    {
      "name": "impeccable",
      "contentRoot": "vendors/impeccable/plugin",
      "cursor": {
        "displayName": "Impeccable",
        "skills": "../../vendors/impeccable/plugin/skills"
      },
      "version": "4.0.4",
      "description": "Design fluency for frontend development. 1 skill with 23 commands (/impeccable polish, /impeccable audit, /impeccable critique, etc.) and curated anti-pattern detection.",
      "author": {
        "name": "Paul Bakaus",
        "email": "paul@paulbakaus.com"
      },
      "homepage": "https://impeccable.style",
      "repository": "https://github.com/pbakaus/impeccable",
      "license": "Apache-2.0",
      "claude": {
        "category": "design",
        "tags": [
          "design",
          "frontend",
          "ui",
          "ux",
          "skills",
          "commands"
        ]
      }
    },
    {
      "name": "superpowers",
      "contentRoot": "vendors/superpowers",
      "cursor": {
        "emitMode": "plugin-root"
      },
      "version": "6.2.0",
      "description": "Core skills library for Claude Code: TDD, debugging, collaboration patterns, and proven techniques",
      "author": {
        "name": "Jesse Vincent",
        "email": "jesse@fsck.com"
      },
      "homepage": "https://github.com/obra/superpowers",
      "repository": "https://github.com/obra/superpowers",
      "license": "MIT"
    },
    {
      "name": "osuperpowers",
      "contentRoot": "packages/osuperpowers",
      "cursor": {
        "emitMode": "plugin-root"
      },
      "version": "0.1.0",
      "description": "Standalone osuperpowers skills: orchestration + cli-* family, CDD engine, cross-harness gate.",
      "author": {
        "name": "Oscaner Miao",
        "email": "oscaner1997@gmail.com"
      },
      "homepage": "https://github.com/Oscaner/skills",
      "repository": "https://github.com/Oscaner/skills",
      "license": "MIT",
      "claude": {
        "category": "osuperpowers",
        "keywords": [
          "osuperpowers",
          "cli",
          "cdd",
          "harness",
          "droid",
          "pi"
        ]
      },
      "hooks": {
        "claude": "./hooks/hooks.json",
        "cursor": "./hooks/hooks-cursor.json",
        "codex": "./.codex-plugin/hooks/hooks.json",
        "qoder": "./.qoder-plugin/hooks/hooks.json"
      }
    },
    {
      "name": "osuperpowers-router",
      "contentRoot": "packages/osuperpowers-router",
      "cursor": {
        "emitMode": "plugin-root"
      },
      "version": "6.2.0-router.0.15.3",
      "description": "Trigger router for osuperpowers: intercepts upstream superpowers triggers and routes to osuperpowers / mattpocock targets.",
      "author": {
        "name": "Oscaner Miao",
        "email": "oscaner1997@gmail.com"
      },
      "homepage": "https://github.com/Oscaner/skills",
      "repository": "https://github.com/Oscaner/skills",
      "license": "MIT",
      "claude": {
        "category": "workflow",
        "tags": [
          "superpowers",
          "mattpocock",
          "overrides",
          "subagents"
        ]
      },
      "hooks": {
        "claude": "./hooks/hooks.json",
        "cursor": "./hooks/hooks-cursor.json"
      }
    }
  ]
}
