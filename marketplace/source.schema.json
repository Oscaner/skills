{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Oscaner/skills/marketplace/source.schema.json",
  "title": "oscaner marketplace source",
  "type": "object",
  "required": ["name", "owner", "metadata", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "owner": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "cursorWrapper": {
      "type": "object",
      "required": ["displayName", "skills"],
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "skills": { "type": "string", "minLength": 1 },
        "hooks": { "type": "string", "minLength": 1 }
      }
    },
    "cursorPluginRoot": {
      "type": "object",
      "required": ["emitMode"],
      "additionalProperties": false,
      "properties": {
        "emitMode": { "type": "string", "enum": ["plugin-root"] }
      }
    },
    "cursor": {
      "oneOf": [
        { "$ref": "#/$defs/cursorWrapper" },
        { "$ref": "#/$defs/cursorPluginRoot" }
      ]
    },
    "plugin": {
      "type": "object",
      "required": ["name", "description", "author", "contentRoot", "cursor"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "description": { "type": "string" },
        "author": { "$ref": "#/$defs/author" },
        "contentRoot": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "homepage": { "type": "string" },
        "repository": { "type": "string" },
        "license": { "type": "string" },
        "claude": { "$ref": "#/$defs/claude" },
        "cursor": { "$ref": "#/$defs/cursor" }
      }
    }
  }
}
