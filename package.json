{
  "name": "@oscaner-skills/marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "ci:version": "pnpm exec changeset version && pnpm run emit",
    "validate": "node scripts/run.ts validate",
    "precommit": "node scripts/run.ts precommit",
    "emit": "node scripts/run.ts emit",
    "emit:check": "node scripts/run.ts emit-check",
    "typecheck": "tsc --noEmit -p packages/cdd-engine && tsc --noEmit -p scripts && tsc --noEmit -p packages/kairos/tests",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "prepare": "husky",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@types/node": "^26.6.4",
    "@changesets/cli": "^3.0.3",
    "@changesets/config": "^4.0.1",
    "@changesets/read": "^1.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
