{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "CDD engine contract word table (packages/cdd-engine/config/contract-lexicon.json) shape authority — the command family (the status values + dual-axis mapping · the stdout capsule keys + read-back wording · the route anchors + stderr station map) and the schema family (the skill-anatomy reference) declared with additionalProperties: false so an unknown member fails validation. The guard lexicon (scripts/lib/guard-lexicon.json) is the guards-family home and is NOT part of this shape: a guards key at the root is an unknown-key violation. Machine-token leaves are arrays (vocab / tokens / routeTokens); wording leaves are plain strings (readbackWording); the route stations are an addressed map chained by station key (the engine output points look up their emitted wording by that key, never a literal at the emission site).",
  "type": "object",
  "required": ["_doc", "command", "schema"],
  "additionalProperties": false,
  "properties": {
    "_doc": { "type": "string" },
    "command": {
      "type": "object",
      "required": ["status", "capsule", "route"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "object",
          "required": ["vocab", "axes"],
          "additionalProperties": false,
          "properties": {
            "vocab": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "axes": {
              "type": "object",
              "required": ["judgment", "work"],
              "additionalProperties": false,
              "properties": {
                "judgment": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "work": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              }
            }
          }
        },
        "capsule": {
          "type": "object",
          "required": ["tokens", "readbackWording"],
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "readbackWording": { "type": "string" }
          }
        },
        "route": {
          "type": "object",
          "required": ["routeTokens", "stations"],
          "additionalProperties": false,
          "properties": {
            "routeTokens": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "stations": {
              "type": "object",
              "required": ["next", "blocked", "warn", "cliMissing"],
              "additionalProperties": false,
              "properties": {
                "next": { "type": "string" },
                "blocked": { "type": "string" },
                "warn": { "type": "string" },
                "cliMissing": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "schema": {
      "type": "object",
      "required": ["anatomy"],
      "additionalProperties": false,
      "properties": {
        "anatomy": {
          "type": "object",
          "required": ["schemaPath", "skillsRoot"],
          "additionalProperties": false,
          "properties": {
            "schemaPath": { "type": "string" },
            "skillsRoot": { "type": "string" }
          }
        }
      }
    }
  }
}
