{
  "name": "@oscaner-skills/cdd-engine",
  "version": "4.0.1",
  "description": "CDD engine CLIs: task runner, docs reviewer, branch reviewer, harness selector.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/",
    "templates/"
  ],
  "main": "./dist/bin.js",
  "exports": {
    ".": "./dist/bin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "cdd": "./dist/bin.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
