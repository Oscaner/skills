{
  "docType": "phase-spec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "phase-spec document structure",
  "description": "Derived JSON Schema — 27 declared elements · 19 required",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "doc-type": {
      "type": "string",
      "pattern": "^(overall-spec|plan|phase-spec|single-spec)$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "presence: required · home: frontmatter · ref: version-lineage"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "slug": {
      "type": "string",
      "pattern": "^(?=.{1,128}$)[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "program": {
      "type": "string",
      "pattern": "^(?=.{1,128}$)[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "presence: required · home: frontmatter · ref: slug-ref"
    },
    "status": {
      "type": "string",
      "pattern": "^(Draft|Approved|Plan pending|Shipped)$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "author": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "parent-version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "presence: optional · home: frontmatter · ref: version-lineage"
    },
    "## Design": {
      "type": "string",
      "pattern": "^## Design$",
      "description": "presence: required · home: design-body · ref: none"
    },
    "### N. group heading": {
      "type": "string",
      "pattern": "^### \\d+\\. ",
      "description": "presence: required · home: design-body · ref: none"
    },
    "#### N.M item heading": {
      "type": "string",
      "pattern": "^#### \\d+\\.\\d+ ",
      "description": "presence: required · home: design-body · ref: none"
    },
    "### Acceptance criteria": {
      "type": "string",
      "pattern": "^### Acceptance criteria$",
      "description": "presence: required · home: design-body · ref: none"
    },
    "Acceptance entry": {
      "type": "string",
      "pattern": "^- `",
      "description": "presence: required · home: design-body · ref: none"
    },
    "## Constraints": {
      "type": "string",
      "pattern": "^## Constraints$",
      "description": "presence: required · home: section · ref: none"
    },
    "Constraint delta bullet": {
      "type": "string",
      "pattern": "^- ",
      "description": "presence: required · home: section · ref: none"
    },
    "## Deviations": {
      "type": "string",
      "pattern": "^## Deviations$",
      "description": "presence: conditional · home: conditional · ref: none"
    },
    "Deviations columns": {
      "type": "string",
      "pattern": "^\\| Overall assumption \\| Phase decision \\| Overall updated\\? \\|$",
      "description": "presence: conditional · home: conditional · ref: none"
    },
    "Deviations row": {
      "type": "string",
      "pattern": "^\\|\\s*[^|]+\\s*\\|\\s*[^|]+\\s*\\|\\s*(Yes|No)\\b",
      "description": "presence: conditional · home: conditional · ref: none"
    },
    "Overall updated answer": {
      "type": "string",
      "pattern": "^Yes",
      "description": "presence: conditional · home: conditional · ref: none"
    },
    "## Incremental warning": {
      "type": "string",
      "pattern": "^## Incremental warning$",
      "description": "presence: conditional · home: conditional · ref: none"
    },
    "## Notes for downstream": {
      "type": "string",
      "pattern": "^## Notes for downstream$",
      "description": "presence: conditional · home: conditional · ref: none"
    },
    "## Review record": {
      "type": "string",
      "pattern": "^## Review record$",
      "description": "presence: conditional · home: conditional · ref: none"
    },
    "## Change history": {
      "type": "string",
      "pattern": "^## Change history$",
      "description": "presence: required · home: section · ref: none"
    },
    "Change history row": {
      "type": "string",
      "pattern": "^\\|\\s*v\\d+\\.\\d+\\s*\\|",
      "description": "presence: required · home: table · ref: version-lineage"
    },
    "Version token": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "presence: required · home: table · ref: version-lineage"
    },
    "Change history date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "presence: required · home: table · ref: none"
    }
  },
  "required": [
    "title",
    "doc-type",
    "version",
    "date",
    "slug",
    "program",
    "status",
    "author",
    "## Design",
    "### N. group heading",
    "#### N.M item heading",
    "### Acceptance criteria",
    "Acceptance entry",
    "## Constraints",
    "Constraint delta bullet",
    "## Change history",
    "Change history row",
    "Version token",
    "Change history date"
  ]
}
