{
  "docType": "plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan document structure",
  "description": "Derived JSON Schema — 31 declared elements · 24 required",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "doc-type": {
      "type": "string",
      "pattern": "^(overall-spec|plan|phase-spec|single-spec)$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "presence: required · home: frontmatter · ref: version-lineage"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "spec": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: required · home: frontmatter · ref: spec-ref"
    },
    "parent-program": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: required · home: frontmatter · ref: parent-program"
    },
    "parent-version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "presence: optional · home: frontmatter · ref: version-lineage"
    },
    "depends-on": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: optional · home: frontmatter · ref: phase-id"
    },
    "base": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: optional · home: frontmatter · ref: none"
    },
    "## Constraints": {
      "type": "string",
      "pattern": "^## Constraints$",
      "description": "presence: required · home: section · ref: none"
    },
    "Constraint delta bullet": {
      "type": "string",
      "pattern": "^- ",
      "description": "presence: required · home: section · ref: none"
    },
    "Constraint delta sub-heading": {
      "type": "string",
      "pattern": "^### ",
      "description": "presence: optional · home: section · ref: none"
    },
    "### Task N:": {
      "type": "string",
      "pattern": "^### Task \\d+:( .*)?$",
      "description": "presence: required · home: task-block · ref: none"
    },
    "Task id token": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "presence: required · home: task-block · ref: task-id"
    },
    "**Objective**": {
      "type": "string",
      "pattern": "^- \\*\\*Objective\\*\\*:",
      "description": "presence: required · home: task-field · ref: none"
    },
    "**Files**": {
      "type": "string",
      "pattern": "^- \\*\\*Files\\*\\*:",
      "description": "presence: required · home: task-field · ref: none"
    },
    "File path token": {
      "type": "string",
      "pattern": "^[\\w./-]+",
      "description": "presence: required · home: task-field · ref: none"
    },
    "**Consumes**": {
      "type": "string",
      "pattern": "^- \\*\\*Consumes\\*\\*:",
      "description": "presence: required · home: task-field · ref: none"
    },
    "**Produces**": {
      "type": "string",
      "pattern": "^- \\*\\*Produces\\*\\*:",
      "description": "presence: required · home: task-field · ref: none"
    },
    "**Steps**": {
      "type": "string",
      "pattern": "^- \\*\\*Steps\\*\\*:",
      "description": "presence: required · home: task-field · ref: none"
    },
    "Step action": {
      "type": "string",
      "pattern": "^- ",
      "description": "presence: required · home: task-step · ref: none"
    },
    "Step checkable": {
      "type": "string",
      "pattern": "—\\s*checkable:\\s*\\S",
      "description": "presence: required · home: task-step · ref: none"
    },
    "**Acceptance**": {
      "type": "string",
      "pattern": "^- \\*\\*Acceptance\\*\\*:",
      "description": "presence: required · home: task-field · ref: none"
    },
    "**DependsOn**": {
      "type": "string",
      "pattern": "^- \\*\\*DependsOn\\*\\*:",
      "description": "presence: required · home: task-field · ref: none"
    },
    "DependsOn none": {
      "type": "string",
      "pattern": "^(none|\\s*)$",
      "description": "presence: optional · home: task-field · ref: none"
    },
    "DependsOn id": {
      "type": "string",
      "pattern": "^[1-9]\\d*$",
      "description": "presence: optional · home: task-field · ref: task-id"
    },
    "Task prose reference": {
      "type": "string",
      "pattern": "\\b(?:Task|T)\\s*([1-9]\\d*)\\b(?!\\.\\d)",
      "description": "presence: optional · home: task-field · ref: task-id"
    },
    "## Change history": {
      "type": "string",
      "pattern": "^## Change history$",
      "description": "presence: required · home: section · ref: none"
    },
    "Change history row": {
      "type": "string",
      "pattern": "^\\|\\s*v\\d+\\.\\d+\\s*\\|",
      "description": "presence: required · home: table · ref: version-lineage"
    },
    "Version token": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "presence: required · home: table · ref: version-lineage"
    },
    "Change history date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "presence: required · home: table · ref: none"
    }
  },
  "required": [
    "title",
    "doc-type",
    "version",
    "date",
    "spec",
    "parent-program",
    "## Constraints",
    "Constraint delta bullet",
    "### Task N:",
    "Task id token",
    "**Objective**",
    "**Files**",
    "File path token",
    "**Consumes**",
    "**Produces**",
    "**Steps**",
    "Step action",
    "Step checkable",
    "**Acceptance**",
    "**DependsOn**",
    "## Change history",
    "Change history row",
    "Version token",
    "Change history date"
  ]
}
