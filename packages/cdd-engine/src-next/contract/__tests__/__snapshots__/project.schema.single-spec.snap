{
  "docType": "single-spec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "single-spec document structure",
  "description": "Derived JSON Schema — 16 declared elements · 15 required",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "doc-type": {
      "type": "string",
      "pattern": "^(overall|plan|phase-spec|single-spec)$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "presence: required · home: frontmatter · ref: version-lineage"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "slug": {
      "type": "string",
      "pattern": "^(?=.{1,128}$)[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "status": {
      "type": "string",
      "pattern": "^(Draft|Approved|In progress|Complete)$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "author": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: required · home: frontmatter · ref: none"
    },
    "issues": {
      "type": "string",
      "pattern": "^.+$",
      "description": "presence: optional · home: frontmatter · ref: none"
    },
    "## Background & root cause": {
      "type": "string",
      "pattern": "^## Background & root cause$",
      "description": "presence: required · home: section · ref: none"
    },
    "## Design decisions": {
      "type": "string",
      "pattern": "^## Design decisions$",
      "description": "presence: required · home: section · ref: none"
    },
    "## Acceptance": {
      "type": "string",
      "pattern": "^## Acceptance$",
      "description": "presence: required · home: section · ref: none"
    },
    "## Constraints": {
      "type": "string",
      "pattern": "^## Constraints$",
      "description": "presence: required · home: section · ref: none"
    },
    "## Change history": {
      "type": "string",
      "pattern": "^## Change history$",
      "description": "presence: required · home: section · ref: none"
    },
    "Change history row": {
      "type": "string",
      "pattern": "^\\|\\s*v\\d+\\.\\d+\\s*\\|",
      "description": "presence: required · home: table · ref: version-lineage"
    },
    "Version token": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$",
      "description": "presence: required · home: table · ref: version-lineage"
    },
    "Change history date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "presence: required · home: table · ref: none"
    }
  },
  "required": [
    "title",
    "doc-type",
    "version",
    "date",
    "slug",
    "status",
    "author",
    "## Background & root cause",
    "## Design decisions",
    "## Acceptance",
    "## Constraints",
    "## Change history",
    "Change history row",
    "Version token",
    "Change history date"
  ]
}
