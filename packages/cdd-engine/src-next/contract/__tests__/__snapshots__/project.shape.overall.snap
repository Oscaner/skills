          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "## Boundary rules",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "## Constraints",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "Constraint delta bullet",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "## Maintenance",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "## Change history",
          "presence": "required",
          "refKind": "none"
        }
      ]
    },
    {
      "home": "facet",
      "elements": [
        {
          "anchor": "### Goal",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "### Non-goals",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "### Cross-cutting",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "#### [MFRBEN] group",
          "presence": "optional",
          "refKind": "none"
        },
        {
          "anchor": "#### Upstream Endorsements",
          "presence": "optional",
          "refKind": "none"
        }
      ]
    },
    {
      "home": "table",
      "elements": [
        {
          "anchor": "Issue inventory columns",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "Issue row",
          "presence": "required",
          "refKind": "issue-ref"
        },
        {
          "anchor": "Issue ref cell",
          "presence": "required",
          "refKind": "issue-ref"
        },
        {
          "anchor": "issuecomment anchor",
