      ]
    },
    {
      "home": "graph",
      "elements": [
        {
          "anchor": "Hard edge",
          "presence": "required",
          "refKind": "phase-id"
        },
        {
          "anchor": "Soft edge",
          "presence": "optional",
          "refKind": "phase-id"
        },
        {
          "anchor": "Graph legend",
          "presence": "required",
          "refKind": "none"
