{
  "docType": "overall",
  "structure": [
    {
      "home": "frontmatter",
      "elements": [
        {
          "anchor": "title",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "doc-type",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "version",
          "presence": "required",
          "refKind": "version-lineage"
        },
        {
          "anchor": "date",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "slug",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "status",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "author",
          "presence": "required",
          "refKind": "none"
        }
      ]
    },
    {
      "home": "section",
      "elements": [
        {
          "anchor": "## Document scope",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "## File paths",
          "presence": "optional",
          "refKind": "none"
        },
        {
          "anchor": "## Program charter",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "## Issue inventory",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "## Phase inventory",
          "presence": "required",
          "refKind": "none"
        },
        {
