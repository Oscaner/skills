          "refKind": "issue-ref"
        },
        {
          "anchor": "Phase inventory columns",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "Phase row",
          "presence": "required",
          "refKind": "phase-id"
        },
        {
          "anchor": "Phase id token",
          "presence": "required",
          "refKind": "phase-id"
        },
        {
          "anchor": "Implementation plan cell",
          "presence": "required",
          "refKind": "markdown-link"
        },
        {
          "anchor": "Design spec cell",
          "presence": "required",
          "refKind": "none"
        },
        {
          "anchor": "Dependency cell",
          "presence": "required",
          "refKind": "phase-id"
        },
        {
          "anchor": "File path row",
          "presence": "optional",
          "refKind": "none"
        },
        {
          "anchor": "Change history row",
          "presence": "required",
          "refKind": "version-lineage"
        },
        {
