{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["plugin", "targets"],
  "additionalProperties": false,
  "properties": {
    "plugin": { "type": "string", "minLength": 1 },
    "$schema": { "type": "string" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "overrides", "source"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^spor-[a-z0-9-]+$"
          },
          "overrides": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:[a-z0-9-]+$"
          },
          "source": { "type": "string", "pattern": "^\\./skills/" }
        }
      }
    }
  }
}
